# Hedera Testnet Account Configuration
# Get your account credentials from https://portal.hedera.com/

# Your Hedera Testnet Account ID (format: 0.0.XXXXXXX)
MY_ACCOUNT_ID=0.0.XXXXXXX

# Your Hedera Testnet Private Key (starts with 0x or 302e...)
MY_PRIVATE_KEY=your_private_key_here

# Treasury Account (same as MY_ACCOUNT_ID for initial setup)
TREASURY_ACCOUNT_ID=0.0.XXXXXXX

# TEC Token ID (will be generated on first run, leave empty initially)
TEC_TOKEN_ID=

# Server Configuration
PORT=3000
